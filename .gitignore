# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
.metadata
*.iml
.idea/
.vscode/

# Generated platform folder (created by `flutter create`, see README)
/android/
/ios/
/linux/
/macos/
/windows/
/web/

# Fonts are downloaded by tool/get_fonts.sh (Inter, OFL licence)
/assets/fonts/*.ttf
# ...except the code font this app ships itself (DejaVu Sans Mono, see assets/fonts/LICENSE-DejaVu.txt)
!/assets/fonts/DejaVuSansMono.ttf
!/assets/fonts/DejaVuSansMono-Bold.ttf

# Signing material must never be committed
*.jks
*.keystore
key.properties
local.properties
